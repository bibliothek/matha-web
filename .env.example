# MathAuth's public URL — the tunnel hostname, used as the OIDC issuer.
# No trailing slash, must match exactly what the browser sees.
AUTH_PUBLIC_URL=https://auth.thaller.space

# Zero Trust dashboard > Networks > Tunnels > create a tunnel > copy the token.
TUNNEL_TOKEN=
# TUNNEL_TRANSPORT_PROTOCOL=auto   # http2 if QUIC/UDP 7844 is blocked
# TUNNEL_LOGLEVEL=info

# Admin account, seeded on first start only. Min. 8 characters.
MATHAUTH_ADMIN_USERNAME=admin
MATHAUTH_ADMIN_PASSWORD=

# Container paths; the files live in DATA_ROOT/mathauth/certs on the host.
# Empty = ephemeral dev certs, which log everyone out on every restart.
MATHAUTH_SIGNING_CERT_PATH=/app/certs/signing.pfx
MATHAUTH_ENCRYPTION_CERT_PATH=/app/certs/encryption.pfx
MATHAUTH_CERT_PASSWORD=

# Must match the corresponding entries in oidc-clients.json.
# Generate secrets with: openssl rand -base64 32
MATHAHUB_CLIENT_ID=hub
MATHAHUB_CLIENT_SECRET=

CHECKLIST_CLIENT_ID=extensible-checklist
CHECKLIST_CLIENT_SECRET=

# AdventRunner — Auth0 + Strava credentials (it does not use MathAuth).
AR_AUTH0_CLIENT_ID=
AR_AUTH0_CLIENT_SECRET=
AR_STRAVA_CLIENT_ID=
AR_STRAVA_CLIENT_SECRET=

MATHAUTH_IMAGE=mthaller/mathauth:latest
MATHAHUB_IMAGE=mthaller/mathahub:latest
CHECKLIST_IMAGE=mthaller/extensiblechecklist:latest
ADVENTRUNNER_IMAGE=mthaller/adventrunner:latest
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.1

# Base host directory for all app state: DATA_ROOT/<appname>/
DATA_ROOT=/app

ASPNETCORE_ENVIRONMENT=Production
TZ=UTC

# Server-to-server URL for MathAuth. Only override if you terminate TLS locally;
# a plain http:// value requires ASPNETCORE_ENVIRONMENT=Development.
# MATHAUTH_INTERNAL_URL=https://auth.thaller.space
